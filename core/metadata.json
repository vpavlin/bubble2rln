        "libsodium",
        "curl"
      ],
      "runtime": [
        "libsodium",
        "curl"
      ]
    },
    "external_libraries": [],
    "cmake": {
      "find_packages": [],
      "extra_sources": [],
      "extra_include_dirs": [
        "src"
      ],
      "extra_link_libraries": []
    }
  }
}
